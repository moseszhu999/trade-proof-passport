{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradeproof.example/schema/supplier-response.v0.5.json",
  "title": "TradeProof Supplier Response v0.5",
  "type": "object",
  "required": [
    "schemaVersion",
    "responseId",
    "requestId",
    "candidateId",
    "answers",
    "state",
    "supplierIdentityVerified",
    "evidenceVerified",
    "formalSubmissionPerformed",
    "eligibilityDecisionCreated"
  ],
  "properties": {
    "schemaVersion": { "const": "tradeproof.supplier-response.v0.5" },
    "responseId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "caseId": { "type": ["string", "null"] },
    "candidateId": { "type": "string", "minLength": 1 },
    "supplierDisplayName": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "submittedBy": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "authorityConfirmedByPlatform": { "const": false }
      },
      "required": ["authorityConfirmedByPlatform"],
      "additionalProperties": true
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "value", "evidenceRefs", "supplierStatementClassification"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "value": {},
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fileName": { "type": "string" },
                "mediaType": { "type": "string" },
                "digest": { "type": "string" },
                "contentUploaded": { "const": false },
                "evidenceVerified": { "const": false }
              },
              "required": ["contentUploaded", "evidenceVerified"],
              "additionalProperties": true
            }
          },
          "supplierStatementClassification": { "const": "supplier_submitted_unverified" }
        },
        "additionalProperties": true
      }
    },
    "declarations": {
      "type": "object",
      "properties": {
        "informationAccurateToSupplierKnowledge": { "type": "boolean" },
        "authorityToRespond": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "state": { "enum": ["supplier_response_draft", "holder_imported_unverified"] },
    "importedByHolder": { "type": "boolean" },
    "supplierIdentityVerified": { "const": false },
    "evidenceVerified": { "const": false },
    "formalSubmissionPerformed": { "const": false },
    "eligibilityDecisionCreated": { "const": false }
  },
  "additionalProperties": true
}
